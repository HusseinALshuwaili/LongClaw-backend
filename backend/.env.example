# Copy this to .env for local dev, or set as real env vars / secrets in your
# hosting platform for production. Never commit a real .env file.

# --- Database ---
# Local dev default uses SQLite (no setup needed). For prod, point at RDS Postgres:
# DATABASE_URL=postgresql://sentinel:CHANGEME@<rds-endpoint>:5432/sentinel
DATABASE_URL=sqlite:///./sentinel.db

# --- LLM provider (Triage Agent) ---
# LLM_PROVIDER=auto means: use Groq if key present, else OpenAI, else HuggingFace, else mock.
# Override with: groq | openai | huggingface | mock
LLM_PROVIDER=auto

# Groq -- FREE tier (14,400 req/day). Get key at console.groq.com (takes 30 seconds).
# Recommended for production on Render -- zero cost for MVP traffic.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI -- paid fallback. Leave blank to skip.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# HuggingFace -- free tier, slower and rate-limited. Get key at huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# --- App ---
ENV=development
# In production, set this to your real frontend domain(s) -- never ship
# with "*" once real user data is flowing through this API.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Scheduler (tactical sweep) ---
SCAN_INTERVAL_MINUTES=10
# Set to "false" on every process except one if you ever scale beyond a
# single worker/instance, or the sweep fires once per process.
ENABLE_SCHEDULER=true

# --- AWS (Config Audit agent) ---
# Prefer NOT setting static keys here. On AWS App Runner/ECS, attach an
# IAM instance/task role instead -- boto3 picks it up automatically, no
# long-lived credentials needed. Only set these for local testing outside AWS:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
