# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://riley:riley_secret@localhost:5432/riley_db

# ── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── OpenAI (optional — Riley falls back to mock if not set) ────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Webhooks (optional) ─────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/.../...

# ── App ─────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-a-long-random-string

# ── FP Thresholds ───────────────────────────────────────────────
# Alerts above this → auto-suppressed
FP_AUTO_SUPPRESS_THRESHOLD=85.0
# Alerts above this → tagged LowPriorityReview
FP_LOW_PRIORITY_THRESHOLD=60.0

# ── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100
